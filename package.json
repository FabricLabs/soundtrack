{
  "name": "@fabric/soundtrack",
  "version": "0.3.0",
  "description": "Listen to music together: rooms with a voted queue, on the web and in Discord voice channels.",
  "main": "scripts/node.js",
  "exports": {
    ".": "./scripts/node.js",
    "./services/*": "./services/*.js",
    "./functions/*": "./functions/*.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "soundtrack": "./scripts/node.js"
  },
  "engines": {
    "node": "26.12.1",
    "npm": ">=12"
  },
  "scripts": {
    "start": "node scripts/node.js",
    "build": "node scripts/build.js",
    "test": "NODE_ENV=test mocha --timeout 20000 tests",
    "coverage": "NODE_ENV=test c8 npm test",
    "lint": "eslint .",
    "link:fabric": "node scripts/link-fabric.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabricLabs/soundtrack.git"
  },
  "keywords": [
    "discord",
    "fabric",
    "jukebox",
    "music",
    "soundtrack"
  ],
  "author": "Fabric Labs <labs@fabric.pub> (https://labs.fabric.pub)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FabricLabs/soundtrack/issues"
  },
  "homepage": "https://github.com/FabricLabs/soundtrack#readme",
  "dependencies": {
    "@fabric/core": "FabricLabs/fabric#feature/passport-v2",
    "@fabric/discord": "FabricLabs/fabric-discord#feature/channels",
    "@fabric/doorman": "FabricLabs/doorman#feature/channels",
    "@fabric/http": "FabricLabs/fabric-http#feature/passport-v2"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "mocha": "12.0.3",
    "neostandard": "0.14.1"
  },
  "allowScripts": {
    "classic-level": true,
    "classic-level@3.0.0": true,
    "zeromq": true,
    "zeromq@6.8.0": true
  },
  "c8": {
    "include": [
      "functions",
      "services"
    ],
    "report-dir": "./reports/coverage"
  }
}
